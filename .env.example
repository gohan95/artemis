# Copy this to .env (gitignored) and fill in real values.

# Required for LLM drafting (`artemis apply`) and resume auto-population
# (`artemis setup`). Get a key from https://aistudio.google.com/apikey.
# Both features degrade to manual entry/prompting when this is unset.
ARTEMIS_LLM_API_KEY=

# Optional overrides -- uncomment to change a default.
# ARTEMIS_LLM_MODEL=gemini-3.8-flash
# ARTEMIS_LLM_TIMEOUT_SECONDS=20
